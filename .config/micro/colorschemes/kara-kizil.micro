color-link default "#e0e0e0"
color-link comment "#7a756f"
color-link identifier "#d6a259"
color-link constant "#cade25"
color-link constant.string "#d6a259"
color-link constant.string.char "#cade25"
color-link statement "#d23d50"
color-link symbol.operator "#2b5f5b"
color-link preproc "#d23d50"
color-link type "#368e5c"
color-link special "#2b5f5b"
color-link underlined "#364f78"
color-link error "bold #e0e0e0,#d23d50"
color-link todo "bold #1a1a1a,#cade25"
color-link statusline "#d6a259,#1a1a1a"
color-link tabbar "#e0e0e0,#1a1a1a"
color-link indent-char "#333333"
color-link line-number "#7a756f"
color-link current-line-number "bold #d23d50"
color-link diff-added "#368e5c"
color-link diff-modified "#d6a259"
color-link diff-deleted "#d23d50"
color-link gutter-error "#d23d50"
color-link gutter-warning "#cade25"
color-link cursor-line "#1a1a1a"
color-link color-column "#1a1a1a"
color-link selection "#d6a259,#d23d50"
