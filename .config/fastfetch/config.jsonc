{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 1
        },
        "color": {
            "1": "38;2;210;61;80",
            "2": "38;2;210;61;80"
        }
    },
    "display": {
        "color": {
            "title": "38;2;210;61;80",
            "keys":  "38;2;210;61;80"
        }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os",             "key": "İşletim Sistemi" },
        {
            "type": "command",
            "key":  "Sistëm Yaşı",
            "text": "echo $(( ($(date +%s) - $(date -d $(head -n1 /var/log/pacman.log | cut -d ' ' -f 1 | tr -d '[]') +%s)) / 86400 )) gün"
        },
        { "type": "board",          "key": "Cihaz" },
        { "type": "kernel",         "key": "Çekirdek" },
        { "type": "packages",       "key": "Paketlër" },
        { "type": "shell",          "key": "Kabuk" },
        { "type": "display",        "key": "Ekran",          "format": "{name} ({width}x{height} @ {scale-factor}x in {inch}\", {refresh-rate} Hz) [{type}]" },
        { "type": "wm",             "key": "Pencere Yöneticisi" },
        { "type": "cursor",         "key": "İmleç" },
        { "type": "terminal",       "key": "Uç Birim" },
        { "type": "terminalfont",   "key": "Uç Birim Yazı Tipi" },
        { "type": "cpu",            "key": "İşlëmci",        "format": "{vendor} {code-name} ({core-types}) @ {freq-max}" },
        {
            "type": "command",
            "key":  "Grafik İşlëmci",
            "text": "echo \"$(lspci -nn -s 01:00.0 | sed -E 's/.*: (.*) Corporation (.*) \\[.*\\] (\\[[0-9a-f:]+\\]).*/\\1 \\2 \\3/') $(fastfetch -c none -l none --pipe -s gpu | awk 'NR==1{print $NF}')\""
        },
        {
            "type": "command",
            "key":  "Grafik İşlëmci",
            "text": "echo \"$(lspci -nn -s 00:02.0 | sed -E 's/.*: (.*) Corporation (.*) (\\[[0-9a-f:]+\\]).*/\\1 \\2 \\3/') $(fastfetch -c none -l none --pipe -s gpu | awk 'NR==2{print $NF}')\""
        },
        {
            "type": "command",
            "key":  "Bëllek",
            "text": "fastfetch -c none -l none --pipe false -s memory:physicalmemory | awk -F': ' 'NR==1{m=$2} NR==2{sub(/^.* - /,\"\",$2); print m \" - \" $2}'"
        },
        { "type": "physicaldisk",   "key": "Fiziikii Disk",    "hideVirtual": true, "format": "{name} ({size}) [{interconnect} {physical-type}]" },
        { "type": "disk",           "key": "Disk ({mountpoint})" },
        {
            "type": "command",
            "key":  "İntërnet Hızı",
            "text": "cat ~/.cache/fastfetch-speedtest.txt 2>/dev/null || echo 'Ölçülmedi'"
        },
        { "type": "locale",         "key": "Dil" },
        "break",
        "colors"
    ]
}
