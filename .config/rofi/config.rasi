/* ---- GENËL AYARLAR ---- */
configuration {
    modes:          "window,drun,run,ssh";
    font:           "JetBrainsMono Nerd Font 13";
    markup-rows:    true;

    display-drun:   "uygulamalar";
    display-run:    "çalıştır";
    display-window: "pencereler";
    display-ssh:    "ssh";
}

/* ---- RENK PALETİ ---- */
* {
    bg:            #050505d9; /* Kara (Cam Opaklığı) */
    fg:            #e0e0e0;   /* Ak */
    alt-bg:        transparent;

    selected-bg:   #d23d50;   /* Kızıl */
    selected-fg:   #d6a259;   /* Boz Sarı */

    border-col:    #d23d50;   /* Kızıl */
    separator-col: #d6a259;   /* Boz Sarı */

    urgent-bg:     #cade25;   /* Sarı */
    active-bg:     #368e5c;   /* Yeşil */

    background-color: transparent;
    text-color:       @fg;
}

/* ---- PENCERE VE BİLEŞËNLËR ---- */
window {
    background-color: @bg;
    border:           2px;
    border-color:     @border-col;
    border-radius:    12px;
    padding:          15px;
    width:            520px;
}

mainbox {
    background-color: transparent;
    spacing:          10px;
}

inputbar {
    background-color: transparent;
    text-color:       @fg;
    padding:          4px;
}

prompt {
    background-color: transparent;
    text-color:       @separator-col;
}

entry {
    background-color:  transparent;
    text-color:        @fg;
    placeholder:       "Filtrelemek için yazın";
    placeholder-color: #7a756f;
}

num-filtered-rows,
textbox-num-sep,
num-rows {
    text-color: #7a756f;
}

case-indicator {
    background-color: transparent;
    text-color:       @fg;
}

listview {
    background-color: transparent;
    border-color:     @separator-col;
    spacing:          4px;
    lines:            8;
}

scrollbar {
    background-color: transparent;
    handle-color:     @border-col;
}

message {
    background-color: transparent;
    border-color:     @separator-col;
}

textbox {
    background-color: transparent;
    text-color:       @fg;
}

/* ---- LİSTE ÖĞELËRİ ---- */
element {
    padding:       6px 10px;
    border-radius: 6px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element alternate.normal {
    background-color: @alt-bg;
    text-color:       @fg;
}

element selected.normal {
    background-color: @selected-bg;
    text-color:       @selected-fg;
}

element normal.active {
    background-color: @active-bg;
    text-color:       @bg;
}

element alternate.active {
    background-color: @active-bg;
    text-color:       @bg;
}

element selected.active {
    background-color: @selected-bg;
    text-color:       @selected-fg;
}

element normal.urgent {
    background-color: @urgent-bg;
    text-color:       @bg;
}

element alternate.urgent {
    background-color: @urgent-bg;
    text-color:       @bg;
}

element selected.urgent {
    background-color: @selected-bg;
    text-color:       @selected-fg;
}
